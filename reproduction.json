{
  "repository": "conditional-handwriting-generation",
  "profiles": {
    "checks": {
      "scope": "Offline behavioral regressions; not a fresh dataset benchmark",
      "commands": [
        [
          "{python}",
          "smoke_test.py"
        ],
        [
          "{python}",
          "test_restored_models.py"
        ],
        [
          "{python}",
          "test_resume.py"
        ],
        [
          "{python}",
          "test_comparison.py"
        ]
      ]
    },
    "train-cgan": {
      "scope": "Full original MLP cGAN training on canonical MNIST: 50 epochs, seed 42, batch 128, CPU; completed fresh in this release",
      "required_inputs": [
        "mnist"
      ],
      "commands": [
        [
          "{python}",
          "train.py",
          "--data",
          "{input:mnist}",
          "--model",
          "cgan",
          "--epochs",
          "50",
          "--output",
          "{output}/cgan",
          "--batch-size",
          "128",
          "--seed",
          "42",
          "--device",
          "cpu"
        ]
      ]
    },
    "train-diffusion": {
      "scope": "Original residual U-Net DDPM training on canonical MNIST; 40 epochs",
      "required_inputs": [
        "mnist"
      ],
      "commands": [
        [
          "{python}",
          "train.py",
          "--data",
          "{input:mnist}",
          "--model",
          "diffusion",
          "--epochs",
          "40",
          "--output",
          "{output}/diffusion",
          "--batch-size",
          "128",
          "--seed",
          "42",
          "--device",
          "cpu"
        ]
      ]
    },
    "evaluate-fresh-cgan": {
      "scope": "Published fresh 50-epoch cGAN weights; 10,000 synthetic samples; 20-epoch synthetic-only classifier; 10,000 real test images; no generator retraining",
      "required_inputs": [
        "mnist"
      ],
      "commands": [
        [
          "{python}",
          "sample.py",
          "--model",
          "cgan",
          "--checkpoint",
          "checkpoints/cgan_fresh50.pt",
          "--samples",
          "10000",
          "--seed",
          "42",
          "--output",
          "{output}/samples"
        ],
        [
          "{python}",
          "evaluate.py",
          "--data",
          "{input:mnist}",
          "--samples",
          "{output}/samples/samples.npz",
          "--epochs",
          "20",
          "--output",
          "{output}/utility"
        ]
      ]
    },
    "resume-cgan": {
      "scope": "Continue a compatible CPU training-state session to a total of 50 epochs; identical data/batch/seed/runtime required",
      "required_inputs": [
        "mnist",
        "session"
      ],
      "commands": [
        [
          "{python}",
          "train.py",
          "--data",
          "{input:mnist}",
          "--model",
          "cgan",
          "--epochs",
          "50",
          "--batch-size",
          "128",
          "--seed",
          "42",
          "--device",
          "cpu",
          "--resume",
          "{input:session}",
          "--output",
          "{output}/continued"
        ]
      ]
    },
    "paired-comparison": {
      "scope": "Fixed three-seed M2 Max reference: cGAN50 CPU, DDPM40 MPS,10000 balanced samples and20-epoch CPU classifiers; all seeds retained; hardware budgets differ",
      "required_inputs": [
        "mnist"
      ],
      "commands": [
        [
          "{python}",
          "comparison.py",
          "--data",
          "{input:mnist}",
          "--out",
          "{output}/comparison"
        ]
      ]
    },
    "replay-comparison": {
      "scope": "Reload the six saved synthetic-trained classifiers and reproduce all 60000 real-test predictions/confusion matrices in the CPU reference; no retraining or synthetic regeneration",
      "required_inputs": [
        "mnist"
      ],
      "commands": [
        [
          "{python}",
          "verify_comparison.py",
          "--data",
          "{input:mnist}",
          "--results",
          "results/comparison-v1",
          "--output",
          "{output}/classifier-replay.json"
        ]
      ]
    }
  },
  "version_packages": [
    "numpy",
    "torch",
    "pandas",
    "scikit-learn",
    "gymnasium",
    "pytest"
  ],
  "external_evidence_limits": "See BENCHMARKS.md and DATA.md. Passing contract checks does not certify historical accuracy, live providers, physical safety or business outcomes."
}
